<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -Indexes
    
    # Si el archivo o directorio existe, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # ============================================
    # RUTAS PÚBLICAS
    # ============================================
    RewriteRule ^$ index.php [L]
    RewriteRule ^conocenos$ index.php [L]
    RewriteRule ^servicios$ index.php [L]
    RewriteRule ^contactos$ index.php [L]
    
    # ============================================
    # RUTAS DE AUTENTICACIÓN
    # ============================================
    RewriteRule ^auth/login$ index.php [L]
    RewriteRule ^auth/logout$ index.php [L]
    RewriteRule ^auth/recuperar$ index.php [L]
    RewriteRule ^auth/restablecer$ index.php [L]
    
    # ============================================
    # RUTAS DEL PANEL ADMINISTRATIVO
    # ============================================
    # Redirigir TODAS las rutas admin a index.php
    RewriteRule ^admin(/.*)?$ index.php [L]
    
    # ============================================
    # RUTAS DEL DASHBOARD
    # ============================================
    RewriteRule ^dashboard$ dashboard/index.php [L]
    RewriteRule ^dashboard/$ dashboard/index.php [L]
    RewriteRule ^ranking$ dashboard/index.php [L]
    RewriteRule ^productos$ dashboard/index.php [L]  
    RewriteRule ^productos/(.*)$ dashboard/index.php [L]
    RewriteRule ^votar$ dashboard/index.php [L]
    RewriteRule ^logout$ dashboard/index.php [L]
    RewriteRule ^login$ dashboard/index.php [L]
    
    # ============================================
    # REGLA PARA RUTAS NO ENCONTRADAS
    # ============================================
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
    
</IfModule>

# Proteger archivos sensibles
<FilesMatch "(config\.php|database\.php|\.env)">
    Order allow,deny
    Deny from all
</FilesMatch>