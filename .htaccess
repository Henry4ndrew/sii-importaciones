<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -Indexes
    
    # Si el archivo o directorio existe, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # ============================================
    # RUTAS PÚBLICAS (van a index.php raíz)
    # ============================================
    RewriteRule ^$ index.php [L]
    RewriteRule ^conocenos$ index.php [L]
    RewriteRule ^servicios$ index.php [L]
    RewriteRule ^contactos$ index.php [L]
    RewriteRule ^login$ index.php [L]
    
    # ============================================
    # RUTAS DEL DASHBOARD (van a dashboard/index.php)
    # ============================================
    # Nota: Para rutas con parámetros, usamos (.*)
    RewriteRule ^dashboard$ dashboard/index.php [L]
    RewriteRule ^ranking$ dashboard/index.php [L]
    RewriteRule ^productos/(.*)$ dashboard/index.php [L]
    RewriteRule ^votar$ dashboard/index.php [L]
    RewriteRule ^logout$ dashboard/index.php [L]
    
    # ============================================
    # CUALQUIER OTRA RUTA (fallback)
    # ============================================
    RewriteRule ^(.*)$ dashboard/index.php [QSA,L]
    
</IfModule>

# Proteger archivos sensibles
<FilesMatch "(config\.php|database\.php|\.env)">
    Order allow,deny
    Deny from all
</FilesMatch>